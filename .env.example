# =============================================================================
# ACT Angel AI — Python Voice Agent (.env.example)
# Copy to .env and fill in real values before starting the service.
# Never commit .env to version control.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL:  postgresql+asyncpg://user:pass@localhost:5432/actangel
# Amazon RDS:        postgresql+asyncpg://user:pass@<rds-endpoint>:5432/actangel
DATABASE_URL=postgresql+asyncpg://actangel:changeme@localhost:5432/actangel

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=replace_with_64_char_hex_secret

# Admin credentials for the Python API dashboard/admin panel
ADMIN_USERID=admin
ADMIN_PASSWORD=replace_with_strong_password

# Secure cookies (set to true in production — requires HTTPS)
SECURE_COOKIES=true

# Optional: override the admin user's display name, role, and org shown in API responses
# ADMIN_DISPLAY_NAME=Admin
# ADMIN_ROLE=SAD
# ORG_ID=default
# ORG_NAME=ACT Angel AI
# ORG_SLUG=act-angel-ai

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production: https://actangels.com (no trailing slash)
ALLOWED_ORIGINS=https://actangels.com,https://www.actangels.com

# ── Domain (used to build the Plivo WebSocket URL in answerCall response) ─────
# Must match the hostname Nginx exposes for the Python service.
DOMAIN=voice.actangels.com

# ── Internal secret (shared with Node.js web app) ────────────────────────────
# Node.js sends X-Internal-Secret header to bypass JWT auth on internal calls.
# Must match ACTANGEL_INGEST_SECRET in the Node.js .env.
ACTANGEL_INGEST_SECRET=replace_with_shared_secret

# URL of the Node.js web app — used by voice_agent.py to post call ingest data
# In production: https://actangels.com
ACTANGEL_INGEST_URL=https://actangels.com

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Sarvam AI (STT) ───────────────────────────────────────────────────────────
SARVAM_API_KEY=replace_with_sarvam_api_key

# ── Redis (active call session persistence) ──────────────────────────────────
# Optional — defaults to redis://localhost:6379/0
# Without Redis, call sessions are in-memory and lost on server restart.
# REDIS_URL=redis://localhost:6379/0

# ── Plivo (phone telephony) ───────────────────────────────────────────────────
# Credentials are stored per-org in the voice_provider_settings table.
# They are saved automatically when a phone number is imported via the dashboard.

# ── Cloudinary (call recording storage) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# ── Appointment API ───────────────────────────────────────────────────────────
# Endpoint on the Node.js app that creates appointments after a call
APPOINTMENT_API_URL=https://actangels.com/api/webhook/call-appointment

# Default assistant ID used when creating outbound appointment call sessions
ASSISTANT_ID=replace_with_assistant_uuid

# Plivo number used as the caller ID for outbound appointment confirmations
FROM_NUMBER=+1xxxxxxxxxx

# ── Cost tracking — optional overrides (defaults shown) ──────────────────────
# All values are USD.  Leave commented to use the built-in defaults.

# SARVAM_STT_COST_PER_MINUTE=0.006
# PLIVO_PHONE_COST_PER_MINUTE=0.003
# PLATFORM_COST_PER_MINUTE=0.000

# Flat per-minute fee charged instead, when an org uses its own Sarvam/OpenAI
# key (BYOK) — they pay that provider directly, so this replaces the usual
# usage-based cost for that component rather than stacking on top of it.
# These can also be set live from the dashboard (SAD > Global API Defaults >
# BYOK Flat Fees) without restarting the service — that takes priority over
# the env values below, which only apply when nothing's been set there.
# BYOK_STT_FLAT_FEE_PER_MINUTE=0.001
# BYOK_LLM_FLAT_FEE_PER_MINUTE=0.002

# OpenAI model pricing per 1 M tokens (input / output)
# OPENAI_GPT5_NANO_INPUT_PER_1M=0.050
# OPENAI_GPT5_NANO_OUTPUT_PER_1M=0.400
# OPENAI_GPT4O_MINI_INPUT_PER_1M=0.150
# OPENAI_GPT4O_MINI_OUTPUT_PER_1M=0.600
# OPENAI_GPT5_MINI_INPUT_PER_1M=0.250
# OPENAI_GPT5_MINI_OUTPUT_PER_1M=2.000
# OPENAI_GPT5_INPUT_PER_1M=1.250
# OPENAI_GPT5_OUTPUT_PER_1M=10.000
# OPENAI_GPT4O_INPUT_PER_1M=2.500
# OPENAI_GPT4O_OUTPUT_PER_1M=10.000
